---
import { site } from "../constants";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  /** 404 drops the chrome and centers in the viewport, like the template. */
  bare?: boolean;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  ogType = "website",
  bare = false,
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;
const canonicalUrl = new URL(canonicalPath, site.url);
const ogImageUrl = new URL("/og.png", site.url);
---

<html class="scheme-only-dark font-mono antialiased" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport" />
    <meta content="rgb(10, 10, 10)" name="theme-color" />
    <link rel="preconnect" href="https://cdn.uinaf.dev" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="undefined is not a function LLC" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={site.title} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <script>
      try {
        if (!sessionStorage.getItem("uinaf-entry-motion-seen")) {
          document.documentElement.dataset.motion = "on";
          sessionStorage.setItem("uinaf-entry-motion-seen", "1");
        }
      } catch {
        document.documentElement.dataset.motion = "on";
      }
    </script>
  </head>
  <body>
    <div
      class:list={[
        "flex min-h-dvh flex-col items-center",
        bare ? "pt-6 pb-[14vh]" : "pt-16 pb-12",
      ]}
    >
      <div class="u-shell-narrow flex flex-1 flex-col">
        {
          !bare && (
            <header class="u-header motion-enter">
              <a class="u-header-mark u-link-plain" href="/" aria-label="Homepage">
                <img src={site.mark} alt="" width="24" height="24" />
                <span class="u-header-name">{site.name}</span>
              </a>
              <p class="u-header-tagline">{site.description.toLowerCase()}</p>
              <nav class="u-nav" aria-label="Primary">
                <a class="u-link-plain" href="/rss.xml">
                  rss
                </a>
                <span class="u-sep" aria-hidden="true">
                  ·
                </span>
                <a class="u-link-plain" href={site.repository}>
                  github ↗
                </a>
              </nav>
            </header>
          )
        }

        <main class="flex flex-1 flex-col">
          <slot />
        </main>

        {
          !bare && (
            <footer class="motion-enter" style="--motion-step: 3">
              <hr class="mt-16" />
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-4 text-sm text-fg-subtle">
                <a class="u-link-plain" href="https://uinaf.dev">
                  ← uinaf.dev
                </a>
                <span class="flex flex-wrap items-baseline gap-2">
                  <a class="u-link-plain" href={`mailto:${site.email}`}>
                    {site.email}
                  </a>
                  <span class="u-sep" aria-hidden="true">
                    ·
                  </span>
                  <a class="u-link-plain" href={site.repository}>
                    source ↗
                  </a>
                </span>
              </div>
            </footer>
          )
        }
      </div>
    </div>
  </body>
</html>
