---
import { site } from "../constants";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  width?: "base" | "narrow";
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  ogType = "website",
  width = "base",
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} · ${site.title}`;
const canonicalUrl = new URL(canonicalPath, site.url);
---

<html class="scheme-only-dark font-mono antialiased" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport" />
    <meta content="rgb(10, 10, 10)" name="theme-color" />
    <link rel="preconnect" href="https://cdn.uinaf.dev" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="undefined is not a function LLC" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content="https://cdn.uinaf.dev/images/webp/uinaf-computer-og-image-1024w.webp"
    />
    <meta property="og:image:alt" content={site.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        if (!sessionStorage.getItem("uinaf-entry-motion-seen")) {
          document.documentElement.dataset.motion = "on";
          sessionStorage.setItem("uinaf-entry-motion-seen", "1");
        }
      } catch {
        document.documentElement.dataset.motion = "on";
      }
    </script>
  </head>
  <body>
    <div class="page-shell" data-width={width}>
      <header class="site-header motion-enter">
        <a class="site-mark link-plain" href="/" aria-label="Homepage">
          <img src={site.mark} alt="" width="24" height="24" />
          <span>{site.name}</span>
        </a>
        <nav aria-label="Primary">
          <a class="link-plain" href="/rss.xml">rss</a>
          <span class="sep" aria-hidden="true">·</span>
          <a class="link-plain" href={site.repository}>github ↗</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer motion-enter" style="--motion-step: 3">
        <hr />
        <div>
          <p>{site.description.toLowerCase()}</p>
          <span>
            <a class="link-plain" href={`mailto:${site.email}`}>{site.email}</a>
            <span class="sep" aria-hidden="true">·</span>
            <a class="link-plain" href={site.repository}>source ↗</a>
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>

