---
import Layout from "../layouts/Layout.astro";
import { site } from "../constants";
---

<Layout title="not found" canonicalPath="/404/" width="narrow">
  <section class="notfound motion-enter" style="--motion-step: 1">
    <img src={site.logo} alt="" width="120" height="120" />
    <p class="eyebrow">404</p>
    <h1>nothing here.<br />maybe it never was.</h1>
    <a class="btn" href="/">browse the intake</a>
  </section>
</Layout>

