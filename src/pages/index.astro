---
import { getCollection } from "astro:content";
import EntryCard from "../components/EntryCard.astro";
import Filters from "../components/Filters.astro";
import Layout from "../layouts/Layout.astro";
import { compareNewest } from "../lib/entries";

const entries = (await getCollection("entries")).sort(compareNewest);
const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))].sort();
const types = [...new Set(entries.map((entry) => entry.data.type))].sort();
---

<Layout>
  {/* The header tagline is the intro; the h1 is the list's own micro-label. */}
  <h1 class="u-label motion-enter" style="--motion-step: 1">entries</h1>

  <div class="motion-enter" style="--motion-step: 2">
    <Filters tags={tags} types={types} total={entries.length} />

    {
      entries.length > 0 ? (
        <ul class="u-list u-list--ruled mt-6" role="list">
          {entries.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </ul>
      ) : (
        <div class="u-empty mt-6">
          <p>nothing here yet.</p>
        </div>
      )
    }
  </div>
</Layout>
