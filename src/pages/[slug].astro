---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import EntryBody from "../components/EntryBody.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import XEmbed from "../components/XEmbed.astro";
import { resolveSourceEmbed } from "../lib/embeds";
import { compareNewest, excerptFor, savedDate, slugFor } from "../lib/entries";
import { site } from "../constants";

export async function getStaticPaths() {
  const entries = (await getCollection("entries")).sort(compareNewest);
  return entries.map((entry) => ({
    params: { slug: slugFor(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"entries">;
}

const { entry } = Astro.props;
const slug = slugFor(entry);
const embed = resolveSourceEmbed(entry.data.type, entry.data.source);
const saved = savedDate(entry);
const editHref = `${site.repository}/blob/main/entries/${entry.id}`;
---

<Layout
  title={entry.data.title}
  description={excerptFor(entry, 280)}
  canonicalPath={`/${slug}/`}
  ogType="article"
  header={false}
  footerNote="agent-written summary"
  footerHref={editHref}
  footerLabel="edit on github ↗"
>
  <article class="flex flex-1 flex-col">
    <p class="u-meta motion-enter">
      <a class="u-link-plain" href="/">← intake</a>
    </p>
    <div class="mt-8 flex flex-col gap-3 motion-enter" style="--motion-step: 1">
      <div class="flex flex-col gap-2">
        <h1 class="text-pretty">{entry.data.title}</h1>
        <p class="u-meta">
          {entry.data.type} · saved <time datetime={saved}>{saved}</time> ·{" "}
          <a class="u-link" href={entry.data.source} style="color: inherit">source ↗</a>
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        {
          entry.data.tags.map((tag) => (
            <a class="u-tag u-link-plain" href={`/?tag=${encodeURIComponent(tag)}`}>
              {tag}
            </a>
          ))
        }
      </div>
    </div>
    {
      embed && (
        <div class="motion-enter" style="--motion-step: 4">
          {embed.kind === "youtube" && <YouTubeEmbed id={embed.video.id} title={entry.data.title} />}
          {embed.kind === "x" && <XEmbed status={embed.status} title={entry.data.title} />}
        </div>
      )
    }
    <div class="mt-6 motion-enter" style="--motion-step: 5">
      <EntryBody body={entry.body ?? ""} />
    </div>
  </article>
</Layout>
