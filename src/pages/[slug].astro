---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import XEmbed from "../components/XEmbed.astro";
import { resolveSourceEmbed } from "../lib/embeds";
import { compareNewest, excerptFor, savedDate, slugFor } from "../lib/entries";

export async function getStaticPaths() {
  const entries = (await getCollection("entries")).sort(compareNewest);
  return entries.map((entry) => ({
    params: { slug: slugFor(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"entries">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = slugFor(entry);
const embed = resolveSourceEmbed(entry.data.type, entry.data.source);
const meta = [savedDate(entry), entry.data.type].join(" · ");
---

<Layout
  title={entry.data.title}
  description={excerptFor(entry, 280)}
  canonicalPath={`/${slug}/`}
  ogType="article"
>
  <article class="flex flex-1 flex-col">
    <div class="motion-enter" style="--motion-step: 1">
      <h1 class="text-md leading-[1.3] font-normal">{entry.data.title}</h1>
      <p class="u-meta mt-1.5">{meta}</p>
      {embed?.kind === "youtube" && <YouTubeEmbed id={embed.video.id} title={entry.data.title} />}
      {embed?.kind === "x" && <XEmbed status={embed.status} title={entry.data.title} />}
    </div>

    <div class="u-prose mt-4 motion-enter" style="--motion-step: 2">
      <Content />
    </div>

    <div class="mt-8 border-t border-line pt-4 motion-enter" style="--motion-step: 3">
      <span class="u-label">source</span>
      <div class="mt-2 flex flex-col gap-2">
        <a class="u-link self-start text-sm" href={entry.data.source}>
          open the original ↗
        </a>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        {
          entry.data.tags.map((tag) => (
            <a class="u-tag u-link-plain" href={`/?tag=${tag}`}>
              #{tag}
            </a>
          ))
        }
      </div>
    </div>
  </article>
</Layout>
