---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import XEmbed from "../components/XEmbed.astro";
import { resolveSourceEmbed } from "../lib/embeds";
import { compareNewest, excerptFor, savedDate, slugFor } from "../lib/entries";

export async function getStaticPaths() {
  const entries = (await getCollection("entries")).sort(compareNewest);
  return entries.map((entry) => ({
    params: { slug: slugFor(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"entries">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = slugFor(entry);
const embed = resolveSourceEmbed(entry.data.type, entry.data.source);
---

<Layout
  title={entry.data.title}
  description={excerptFor(entry, 280)}
  canonicalPath={`/${slug}/`}
  ogType="article"
  width="narrow"
>
  <article class="detail">
    <a class="back-link link-plain motion-enter" style="--motion-step: 1" href="/">← all entries</a>
    <header class="motion-enter" style="--motion-step: 1">
      <p class="eyebrow">{entry.data.type}</p>
      <h1>{entry.data.title}</h1>
      <div class="detail-meta">
        <time datetime={savedDate(entry)}>{savedDate(entry)}</time>
      </div>
      <ul class="tag-list" role="list">
        {
          entry.data.tags.map((tag) => (
            <li>
              <a class="link-plain" href={`/?tag=${tag}`}>
                #{tag}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="source-link" href={entry.data.source}>open the original source ↗</a>
      {
        embed?.kind === "youtube" && (
          <YouTubeEmbed id={embed.video.id} title={entry.data.title} />
        )
      }
      {
        embed?.kind === "x" && <XEmbed status={embed.status} title={entry.data.title} />
      }
    </header>
    <div class="prose motion-enter" style="--motion-step: 2">
      <Content />
    </div>
  </article>
</Layout>

