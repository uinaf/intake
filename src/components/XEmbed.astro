---
import { xStatusEmbedUrl, type XStatus } from "../lib/x-status";

interface Props {
  status: XStatus;
  title: string;
}

const { status, title } = Astro.props;
const href = xStatusEmbedUrl(status);
const label = `Play on X: ${title}`;
---

<figure class="source-embed source-embed--x">
  <a
    class="source-embed-facade source-embed-facade--x"
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={label}
  >
    <span class="source-embed-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path d="M8 5.14v13.72L19.5 12 8 5.14z"></path>
      </svg>
    </span>
    <span class="source-embed-x-copy">
      <span class="source-embed-x-action">play on x</span>
    </span>
  </a>
</figure>
