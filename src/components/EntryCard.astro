---
import type { IntakeEntry } from "../lib/entries";
import { excerptFor, savedDate, slugFor } from "../lib/entries";

interface Props {
  entry: IntakeEntry;
}

const { entry } = Astro.props;
const slug = slugFor(entry);
const excerpt = excerptFor(entry);
const saved = savedDate(entry);
---

<li
  class="u-list-row"
  data-entry={slug}
  data-type={entry.data.type}
  data-tags={entry.data.tags.join(" ")}
>
  <a class="u-link-plain" href={`/${slug}/`}>
    <span class="u-list-title">{entry.data.title}</span>
    <time class="u-list-meta" datetime={saved}>{saved}</time>
  </a>
  {excerpt && <p class="u-list-desc">{excerpt}</p>}
  <div class="mt-2 flex flex-wrap items-center gap-2">
    <span class="u-tag">{entry.data.type}</span>
    {entry.data.tags.map((tag) => <span class="u-tag">#{tag}</span>)}
  </div>
</li>
