---
interface Props {
  tags: Array<string>;
  types: Array<string>;
  total: number;
}

const { tags, types, total } = Astro.props;
---

<section class="filters" aria-label="find something" data-filters>
  <div class="filter-grid">
    <label class="search-field">
      <span>search</span>
      <input name="q" type="search" placeholder="title, summary, tag…" autocomplete="off" data-query />
    </label>

    <label>
      <span>type</span>
      <select name="type" data-filter="type">
        <option value="">all types</option>
        {types.map((type) => <option value={type}>{type}</option>)}
      </select>
    </label>

    <label>
      <span>tag</span>
      <select name="tag" data-filter="tag">
        <option value="">all tags</option>
        {tags.map((tag) => <option value={tag}>#{tag}</option>)}
      </select>
    </label>
  </div>
  <div class="filter-status">
    <p aria-live="polite">
      <span data-count>{total}</span> entries
      <span hidden data-search-error> · search unavailable</span>
    </p>
    <button type="button" data-clear>clear filters</button>
  </div>
</section>

<script>
  import { createSearchIndexLoader } from "../lib/search";

  const root = document.querySelector<HTMLElement>("[data-filters]");
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-entry]"));

  if (root && rows.length > 0) {
    const query = root.querySelector<HTMLInputElement>("[data-query]");
    const filters = Array.from(root.querySelectorAll<HTMLSelectElement>("[data-filter]"));
    const count = root.querySelector<HTMLElement>("[data-count]");
    const clear = root.querySelector<HTMLButtonElement>("[data-clear]");
    const searchError = root.querySelector<HTMLElement>("[data-search-error]");
    let applyVersion = 0;
    const ensureIndex = createSearchIndexLoader(async () => {
      const response = await fetch("/index.json");
      if (!response.ok) throw new Error(`search index returned ${response.status}`);
      return response.json();
    });

    const apply = async () => {
      const version = ++applyVersion;
      const term = query?.value.trim().toLowerCase() ?? "";
      const values = Object.fromEntries(
        filters.map((filter) => [filter.dataset.filter ?? "", filter.value]),
      ) as Record<string, string>;
      let searchIndex: Record<string, string> | undefined;
      try {
        searchIndex = term ? await ensureIndex() : undefined;
      } catch {
        if (version === applyVersion && searchError) searchError.hidden = false;
        return;
      }
      if (version !== applyVersion) return;
      if (searchError) searchError.hidden = true;
      let visible = 0;

      for (const row of rows) {
        const slug = row.dataset.entry ?? "";
        const matches =
          (!term || searchIndex?.[slug]?.includes(term)) &&
          (!values.type || row.dataset.type === values.type) &&
          (!values.tag || row.dataset.tags?.split(" ").includes(values.tag));
        row.hidden = !matches;
        if (matches) visible += 1;
      }

      if (count) count.textContent = String(visible);
      const params = new URLSearchParams();
      if (term) params.set("q", term);
      for (const [key, value] of Object.entries(values)) {
        if (value) params.set(key, value);
      }
      history.replaceState(null, "", params.size ? `?${params}` : location.pathname);
    };

    const params = new URLSearchParams(location.search);
    if (query) query.value = params.get("q") ?? "";
    for (const filter of filters) {
      filter.value = params.get(filter.dataset.filter ?? "") ?? "";
    }

    query?.addEventListener("input", () => void apply());
    for (const filter of filters) filter.addEventListener("change", () => void apply());
    clear?.addEventListener("click", () => {
      if (query) query.value = "";
      for (const filter of filters) filter.value = "";
      void apply();
      query?.focus();
    });
    void apply();
  }
</script>
