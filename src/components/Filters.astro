---
interface Props {
  tags: Array<string>;
}

const { tags } = Astro.props;
---

<section class="mt-10" aria-label="find something" data-filters>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="u-field">
      <span class="u-label">search</span>
      <input
        class="u-input"
        name="q"
        type="search"
        placeholder="title, summary, tag…"
        autocomplete="off"
        data-query
      />
    </label>

    <label class="u-field">
      <span class="u-label">tag</span>
      <select class="u-select" name="tag" data-filter="tag">
        <option value="">all tags</option>
        {tags.map((tag) => <option value={tag}>{tag}</option>)}
      </select>
    </label>
  </div>
  <p class="u-help mt-2" hidden data-search-error>search unavailable</p>
</section>

<script>
  import { createSearchIndexLoader } from "../lib/search";

  const root = document.querySelector<HTMLElement>("[data-filters]");
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-entry]"));
  const count = document.querySelector<HTMLElement>("[data-count]");
  const clear = document.querySelector<HTMLButtonElement>("[data-clear]");

  if (root && rows.length > 0) {
    const query = root.querySelector<HTMLInputElement>("[data-query]");
    const tagFilter = root.querySelector<HTMLSelectElement>("[data-filter='tag']");
    const searchError = root.querySelector<HTMLElement>("[data-search-error]");
    let applyVersion = 0;
    const ensureIndex = createSearchIndexLoader(async () => {
      const response = await fetch("/index.json");
      if (!response.ok) throw new Error(`search index returned ${response.status}`);
      return response.json();
    });

    const apply = async () => {
      const version = ++applyVersion;
      const term = query?.value.trim().toLowerCase() ?? "";
      const tag = tagFilter?.value ?? "";
      let searchIndex: Record<string, string> | undefined;
      try {
        searchIndex = term ? await ensureIndex() : undefined;
      } catch {
        if (version === applyVersion && searchError) searchError.hidden = false;
        return;
      }
      if (version !== applyVersion) return;
      if (searchError) searchError.hidden = true;
      let visible = 0;

      for (const row of rows) {
        const slug = row.dataset.entry ?? "";
        const matches =
          (!term || searchIndex?.[slug]?.includes(term)) &&
          (!tag || (row.dataset.tags?.split(" ").includes(tag) ?? false));
        row.hidden = !matches;
        if (matches) visible += 1;
      }

      if (count) count.textContent = String(visible);
      if (clear) clear.hidden = !term && !tag;
      const params = new URLSearchParams();
      if (term) params.set("q", term);
      if (tag) params.set("tag", tag);
      history.replaceState(null, "", params.size ? `?${params}` : location.pathname);
    };

    const params = new URLSearchParams(location.search);
    if (query) query.value = params.get("q") ?? "";
    if (tagFilter) tagFilter.value = params.get("tag") ?? "";

    query?.addEventListener("input", () => void apply());
    tagFilter?.addEventListener("change", () => void apply());
    clear?.addEventListener("click", () => {
      if (query) query.value = "";
      if (tagFilter) tagFilter.value = "";
      void apply();
      query?.focus();
    });
    void apply();
  }
</script>
