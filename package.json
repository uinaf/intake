{
  "name": "uinaf-intake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "oxlint --ignore-pattern '*.astro'",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check && tsc --noEmit",
    "check:entries": "bun scripts/validate-entries.ts",
    "check:links": "bun scripts/check-links.ts",
    "intake:find": "bun scripts/find-source.ts",
    "check": "bun run check:entries && bun run lint && bun run typecheck && bun run format:check",
    "verify": "bun run check && bun run build && bun run check:links"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.15",
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.10.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "rollup": "4.60.3",
    "smol-toml": "1.6.1",
    "yaml": "2.9.0"
  }
}
