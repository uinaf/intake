{
  "name": "uinaf-intake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "lint": "oxlint --ignore-pattern '*.astro'",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check && tsc --noEmit",
    "icons": "bun scripts/icons.ts",
    "check:entries": "bun scripts/validate-entries.ts",
    "check:links": "bun scripts/check-links.ts",
    "check:build-budget": "bun scripts/check-build-budget.ts",
    "check:cloudflare": "wrangler deploy --dry-run && bun scripts/check-cloudflare.ts",
    "intake:find": "bun scripts/find-source.ts",
    "test": "bun test",
    "audit": "bun audit --audit-level=high",
    "check": "bun run check:entries && bun run test && bun run lint && bun run typecheck && bun run format:check && bun run design:check",
    "skill:lint": "TESSL_AUTO_UPDATE_INTERVAL_MINUTES=0 tessl plugin lint skills/uinaf-intake",
    "verify": "bun run check && bun run build && bun run check:build-budget && bun run check:links && bun run check:cloudflare",
    "design:check": "design-check src"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.15",
    "@uinaf/design": "^1.13.4",
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "1.3.14",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.1.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.72.0",
    "png-to-ico": "^3.0.2",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "wrangler": "4.120.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "rollup": "4.60.3",
    "smol-toml": "1.6.1",
    "yaml": "2.9.0"
  }
}
